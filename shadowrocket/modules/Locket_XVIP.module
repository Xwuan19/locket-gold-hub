#!name=Locket-XVIP (Super VIP Pro Max)
#!desc=Kích hoạt Locket Gold trọn đời + 30s Video Real + AI Filters + Photobooth 4 Ô ghép ảnh + Custom Frames. By Xwuan
#!category=Xwuan VIP

[Rule]
# Chặn QUIC/UDP để ép dùng TCP/HTTP
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,ingest.sentry.io,REJECT

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-modified-since
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-none-match
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-modified-since

[Script]
# --- 1. REVENUECAT: Mở khóa Locket Gold trọn đời ---
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_revenuecat_response.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_revenuecat_request.js, timeout=60

# --- 2. FIREBASE: Mở khóa 30s Video, AI Filters, Photobooth & Chặn QC ---
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_firebase_response.js, requires-body=true, max-size=-1, timeout=60

# --- 3. PHOTOBOOTH 4 Ô & AI FILTER: Ghép ảnh liên hoàn & chống lỗi bộ lọc ---
locket_pb = type=http-request, pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage, script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_photobooth.js, requires-body=true, max-size=-1, timeout=60

# --- 4. LOCKET API: Gỡ khóa ảnh mờ, huy hiệu Gold chính chủ, bypass paywall ---
locket_api = type=http-response, pattern=^https?:\/\/api\.locketcamera\.com\/.+, script-path=https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_filter_response.js, requires-body=true, max-size=-1, timeout=60

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, *.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
