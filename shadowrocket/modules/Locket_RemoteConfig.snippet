# Locket-XVIP (Super VIP Pro Max 30s) for Quantumult X
# By Xwuan

[rewrite_remote]

[rewrite_local]
^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$) url script-response-body https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_revenuecat_response.js
^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) url script-request-header https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_revenuecat_request.js
^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ url script-response-body https://raw.githubusercontent.com/Xwuan19/Locket-XVIP/main/js/locket_firebase_response.js

[mitm]
hostname = api.revenuecat.com, firebaseremoteconfig.googleapis.com
